---
import Base from "../layouts/Base.astro";
import { LivePreview } from "../components/LivePreview";
---

<Base
  title="Components"
  description="The Civic Calm components, shown live and reviewable in every display mode."
>
  <div class="gov-container">
    <div class="gov-stack gov-stack--8">
      <section class="gov-stack gov-stack--4">
        <h1>Components</h1>
        <p class="site-hero__lead">
          Every component below is the real <code class="gov-reference">@nepal-gov/ui</code> React
          component, styled by <code class="gov-reference">@nepal-gov/css</code>. Use the preview
          controls to walk the whole set through each display mode and either language — the same
          check an accessibility reviewer runs before a release.
        </p>
      </section>

      <section aria-labelledby="preview-heading" class="gov-stack gov-stack--4">
        <h2 id="preview-heading">Live preview</h2>
        {/* Only this island hydrates; the rest of the page is static HTML. */}
        <LivePreview client:load />
      </section>
    </div>
  </div>
</Base>
