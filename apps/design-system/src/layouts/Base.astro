---
// The root layout. Every page is server-rendered to static HTML; the only JavaScript that ships
// is the theme-init script (below) plus whichever islands a page opts into. This is what keeps a
// content page inside §8.1's performance budget while still demonstrating the real components.
import { themeInitScript } from "@nepal-gov/ui";
import { guidelines } from "@nepal-gov/tokens";

// The three stylesheets, imported once here so Astro bundles them. @nepal-gov/css carries the
// self-hosted Noto fonts (§9.2 prohibits CDN fonts); Vite resolves the woff2 URLs from the package.
import "@nepal-gov/tokens/tokens.css";
import "@nepal-gov/css/fonts.css";
import "@nepal-gov/css/civic-calm.css";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  lang?: "ne" | "en";
}

const { title, description, lang = "en" } = Astro.props;
const fullTitle = `${title} — Civic Calm`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* Runs before first paint so the persisted display mode is on <html> before any content
        renders — no flash of the wrong theme. It is the one inline script the site ships. */}
    <script is:inline set:html={themeInitScript} />
  </head>
  <body>
    <a class="gov-skip-link" href="#main">Skip to main content</a>
    <slot name="header" />
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="gov-container">
        <p class="gov-text-secondary gov-text-small">
          An unofficial, community-led design system. Built from design-guidelines
          <code class="gov-reference">{guidelines.version}</code> ({guidelines.status}).
        </p>
      </div>
    </footer>
  </body>
</html>
