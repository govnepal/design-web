{
  "name": "@govnepal/tokens",
  "version": "0.1.0",
  "description": "Civic Calm design tokens — CSS custom properties generated from design-guidelines, per display mode.",
  "license": "MIT",
  "type": "module",
  "keywords": ["nepal", "government", "design-system", "design-tokens", "civic-calm", "css-variables", "a11y"],
  "homepage": "https://github.com/govnepal/design-web/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govnepal/design-web.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/govnepal/design-web/issues",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build/index.mjs",
    "prepack": "node build/index.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
