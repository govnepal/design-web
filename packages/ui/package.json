{
  "name": "@nepal-gov/ui",
  "version": "0.1.0",
  "description": "Civic Calm React components — the behavior layer (ARIA, keyboard, focus) over @nepal-gov/css.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node build/generate.mjs",
    "build": "node build/generate.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node build/generate.mjs && tsc -p tsconfig.build.json --noEmit",
    "test": "node --import ./test/setup.mjs --test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nepal-gov/css": "workspace:*",
    "@nepal-gov/tokens": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "global-jsdom": "^29.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.0"
  }
}
